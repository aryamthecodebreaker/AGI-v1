{
  "name": "agi-v1",
  "version": "0.1.0",
  "description": "A multi-user chatbot with cross-conversation memory, shared Postgres hosting, and sandboxed PR-only capability generation.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "warm": "tsx scripts/warm-models.ts",
    "check:native": "node -e \"require('better-sqlite3'); console.log('better-sqlite3 OK on Node',process.version)\""
  },
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
  "author": "Aryam",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryamthecodebreaker/AGI-v1.git"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@huggingface/transformers": "^3.3.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/sandbox": "^2.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
