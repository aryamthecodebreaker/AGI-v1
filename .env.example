# Server
PORT=3000
HOST=127.0.0.1

# Auth — if missing, a random one is generated and written to .env on first run
# For Vercel deployment, set this to a secure random string (min 32 chars)
JWT_SECRET=

# Data / models
# For Vercel: use /tmp/agi-data for serverless compatibility
DATA_DIR=./data

# Shared hosted storage. Leave empty to use local SQLite.
# Vercel's Neon integration provisions this automatically.
DATABASE_URL=

# LLM backend: "gemini"      (default — Google Gemini API, works on any host)
#              "transformers" (local @huggingface/transformers, needs ~500MB on disk)
#              "scratch"      (from-scratch transformer, Step 11)
# Also supported: "openrouter" for OpenRouter's hosted OpenAI-compatible API.
LLM_BACKEND=gemini

# For LLM_BACKEND=gemini, set this to a Gemini model ID:
#   gemini-3-flash-preview (default)
# For LLM_BACKEND=openrouter, use an OpenRouter model ID such as:
#   openrouter/free
# For LLM_BACKEND=transformers, set to an HF model ID like:
#   HuggingFaceTB/SmolLM2-360M-Instruct
#   onnx-community/Qwen2.5-1.5B-Instruct
LLM_MODEL_ID=gemini-3-flash-preview

# Required when LLM_BACKEND=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AGI-v1's own no-key public search + safe direct-URL inspection tool.
GEMINI_WEB_SEARCH_ENABLED=true
# Gemini 3 can spend most of a small output budget on hidden reasoning. Minimal
# keeps chat, extraction, and capability JSON complete and lowers latency.
GEMINI_THINKING_LEVEL=minimal
# Ordered stable-model failover when the primary model is unavailable or its
# model-specific quota is exhausted. Leave empty to disable model failover.
GEMINI_FALLBACK_MODEL_IDS=gemini-3.5-flash,gemini-3.1-flash-lite

# Required when LLM_BACKEND=openrouter. Keep this server-side and never commit a value.
OPENROUTER_API_KEY=
# Optional comma-separated fallbacks for ordinary streamed chat.
OPENROUTER_FALLBACK_MODEL_IDS=
# Final fallback for schema-validated background extraction and drafting calls.
OPENROUTER_TASK_FALLBACK_MODEL_ID=openrouter/free
# Web requests use a router that filters for server-tool support.
OPENROUTER_WEB_SEARCH_MODEL_ID=openrouter/free
OPENROUTER_WEB_SEARCH_ENABLED=true

# Embedding model (local, ~90MB). Used regardless of LLM backend.
EMBED_MODEL_ID=Xenova/all-MiniLM-L6-v2

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Environment: development|production|test
NODE_ENV=development

# Authenticated-user, PR-only generated capability builder. Keep disabled until a
# least-privilege GitHub App is installed only on this repository.
CAPABILITY_BUILDER_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Store PEM newlines literally in a local .env; Vercel supports multiline values.
GITHUB_APP_PRIVATE_KEY=
