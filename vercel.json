{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": null,
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{public/**,src/storage/migrations/**,node_modules/onnxruntime-node/bin/napi-v3/linux/x64/**}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "NODE_ENV": "production",
    "LLM_BACKEND": "openrouter",
    "LLM_MODEL_ID": "qwen/qwen3-next-80b-a3b-instruct:free",
    "OPENROUTER_FALLBACK_MODEL_IDS": "meta-llama/llama-3.3-70b-instruct:free,google/gemma-4-31b-it:free,openai/gpt-oss-20b:free",
    "DATA_DIR": "/tmp/agi-data"
  }
}
